# ========================================================
# إعدادات سيرفر مزامنة تطبيق تكعيب الغضب (VPS - Plesk)
# ========================================================

# منفذ التشغيل (Plesk يقوم بتعيينه تلقائياً عبر process.env.PORT)
PORT=3000

# رمز أمان الشركة (Secret API Key)
# ضع هنا رمزاً قوياً وخاصاً بشركتك (مثال: Ghadab_Sync_Secret_2026_SecureKey)
COMPANY_SECRET_KEY=Ghadab_Sync_2026_SecretKey

# المسار المخصص لتخزين صور السيارات على السيرفر (افتراضياً مجلد uploads في نفس المشروع)
PHOTOS_DIR=./uploads

# اسم ومسار ملف قاعدة البيانات المركزية الآمنة
DATABASE_FILE=./database.json
